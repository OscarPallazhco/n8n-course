    {
      "parameters": {
        "jsCode": "\nconst items = $input.all();\nconst newInventory = items.map((item) => item.json.data).flat();\nconst newOrders = $('List requests').first().json.data;\n\nfor (const newOrder of newOrders) {\n  const sizeProduct = newInventory.find(item => item.Size === newOrder['Talla de camiseta']);\n\n  // No se encuentra el producto por talla\n  if ( !sizeProduct ) continue;\n  \n  if ( !sizeProduct.Quantity ) continue;\n\n  // No hay existencias\n  if ( sizeProduct.Quantity <= 0) continue;\n\n  // Esto muta el item en el arreglo\n  sizeProduct.Quantity--;\n  newOrder.is_assigned = true;\n  \n}\n\n\n\nreturn {\n  newInventory,\n  orders: newOrders,\n}"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
