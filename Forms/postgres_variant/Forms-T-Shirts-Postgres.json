        "subject": "n8n course - TShirts process completed",
        "message": "=<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"UTF-8\">\n<style>\n    body {\n        font-family: Arial, sans-serif;\n        color: #333;\n        line-height: 1.5;\n    }\n    .container {\n        max-width: 700px;\n        margin: auto;\n        padding: 20px;\n    }\n    h2 {\n        color: #2c3e50;\n    }\n    table {\n        width: 100%;\n        border-collapse: collapse;\n        margin-top: 15px;\n        margin-bottom: 25px;\n    }\n    th, td {\n        border: 1px solid #ddd;\n        padding: 8px 10px;\n        text-align: left;\n    }\n    th {\n        background: #f5f5f5;\n    }\n    .success {\n        color: #1e7e34;\n        font-weight: bold;\n    }\n    .footer {\n        margin-top: 30px;\n        font-size: 12px;\n        color: #777;\n    }\n</style>\n</head>\n\n<body>\n<div class=\"container\">\n\n<h2>✅ T-Shirt Request Process Completed</h2>\n\n<p class=\"success\">\nThe T-shirt request process has finished successfully. The inventory has been updated.\n</p>\n\n<p>\n<b>Total Requests Processed:</b> {{ $('Iterate requests').all().length }}\n\n</p>\n\n<h3>Updated Inventory</h3>\n\n<table>\n<tr>\n    <th>Size</th>\n    <th>Remaining Quantity</th>\n</tr>\n\n{{ $('Get final inventory').all().map(item => `\n<tr>\n    <td>${item.json.size}</td>\n    <td>${item.json.quantity_in_stock}</td>\n</tr>\n`).join('') }}\n\n\n</table>\n\n\n\n<h3>Processed Requests</h3>\n\n<table>\n<tr>\n    <th>Name</th>\n    <th>Size</th>\n    <th>Email</th>\n    <th>Status</th>\n</tr>\n\n{{ $('Get final tshirts requests').all().map(order => `\n<tr>\n    <td>${order.json.Nombre}</td>\n    <td>${order.json[\"Talla de camiseta\"]}</td>\n    <td>${order.json[\"Dirección de correo electrónico\"]}</td>\n    <td>${order.json.is_assigned ? \"Assigned\" : \"Not Assigned\"}</td>\n</tr>\n`).join('') }}\n\n</table>\n\n\n\n</div>\n</body>\n</html>",
