        "message": "=<div style=\"font-family: Arial, Helvetica, sans-serif; max-width: 650px; margin: 0 auto; color: #333; line-height: 1.6;\">\n\n  <h1 style=\"font-size: 24px; color: #1f2937; margin-bottom: 24px;\">\n    Response to the Request for Time Off\n  </h1>\n\n  <p>\n    Dear <strong>{{ $('On form submission').item.json.completeName }}</strong>,\n  </p>\n\n  <p>\n    Thank you for submitting your request for time off. After reviewing your\n    request, we regret to inform you that it has been <strong>denied</strong>.\n  </p>\n\n  <!-- Request Details -->\n  <div style=\"\n    margin: 24px 0;\n    padding: 20px;\n    background-color: #f8f9fa;\n    border: 1px solid #e5e7eb;\n    border-radius: 8px;\n  \">\n\n    <h2 style=\"\n      font-size: 17px;\n      color: #1f2937;\n      margin: 0 0 16px 0;\n    \">\n      Request Details\n    </h2>\n\n    <p style=\"margin: 8px 0;\">\n      <strong>Employee:</strong>\n      {{ $('On form submission').item.json.completeName }}\n    </p>\n\n    <p style=\"margin: 8px 0;\">\n      <strong>Start date:</strong>\n      {{ $('On form submission').item.json.startDate }}\n    </p>\n\n    <p style=\"margin: 8px 0;\">\n      <strong>End date:</strong>\n      {{ $('On form submission').item.json.endDate }}\n    </p>\n\n    <p style=\"margin: 8px 0;\">\n      <strong>Days requested:</strong>\n      {{ $('calculate daysRequested').item.json.daysRequested }}\n    </p>\n\n    <p style=\"margin: 8px 0;\">\n      <strong>Comments:</strong>\n      {{ $('On form submission').item.json.comments }}\n    </p>\n\n    <p style=\"margin: 8px 0;\">\n      <strong>Requested at:</strong>\n      {{ $('On form submission').item.json.submittedAt }}\n    </p>\n\n  </div>\n\n  <!-- Reason -->\n  <div style=\"\n    margin: 24px 0;\n    padding: 16px 20px;\n    background-color: #f8f9fa;\n    border-left: 4px solid #6b7280;\n    border-radius: 4px;\n  \">\n    <p style=\"margin: 0 0 6px 0;\">\n      <strong>Reason for denial</strong>\n    </p>\n\n    <p style=\"margin: 0;\">\n      {{ $json.reason || \"Unspecified\" }}\n    </p>\n  </div>\n\n  <p>\n    If you have any questions regarding this decision, please contact HR.\n  </p>\n\n  <p style=\"margin-top: 32px;\">\n    Best regards,<br>\n    <strong>HHRR</strong>\n  </p>\n\n</div>\n:::",
